# Copy to .env and adjust. Never put credentials in this file or in code:
# Bedrock uses the standard AWS credential chain (an IAM role in deployment).

# --- Engine (defaults point at the local sandbox) ---
WH_COMPOSE_PROJECT=witching-hour-sandbox
WH_TOXIPROXY_URL=http://127.0.0.1:8474
WH_PROMETHEUS_URL=http://127.0.0.1:9090
WH_LOKI_URL=http://127.0.0.1:3100
WH_SERVICE_ADMIN_URLS={"storefront":"http://127.0.0.1:8081","cart":"http://127.0.0.1:8082","payments":"http://127.0.0.1:8083","worker":"http://127.0.0.1:8084"}
# WH_LEDGER_PATH=engine/.witching/ledger.json
# WH_HAUNTINGS_DIR=hauntings

# --- Game server ---
PORT=4000
WH_GRAFANA_URL=http://127.0.0.1:3000
# Escalation speed: 1 is real time, 10 runs a 10-minute haunting in 1 minute.
WH_TIME_SCALE=1
WH_SESSION_MAX_MINUTES=45
# WH_DATA_DIR=server/.data

# --- Narrator ---
# "static" uses the hand-written lines. "bedrock" rewrites them with Claude on Amazon Bedrock.
WH_NARRATOR=static
AWS_REGION=us-east-1
# WH_BEDROCK_MODEL_ID=anthropic.claude-opus-5-5

# --- Sandbox ---
# Throwaway password for the sandbox's own Postgres. It is only reachable inside the sandbox network.
WH_PG_PASSWORD=shop
WH_TRAFFIC_RPS=5
