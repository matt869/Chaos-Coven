{
  "name": "@witching-hour/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Game server: sessions, restricted terminal, Bedrock narrator, scoring and the Daemonwatch drills API.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
