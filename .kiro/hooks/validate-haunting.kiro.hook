{
  "enabled": true,
  "name": "Validate hauntings",
  "description": "Validates every haunting against hauntings/schema.json whenever a haunting file changes.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": ["hauntings/*.yaml", "hauntings/schema.json"]
  },
  "then": {
    "type": "runCommand",
    "command": "npm run validate:hauntings"
  }
}
