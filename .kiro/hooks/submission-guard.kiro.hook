{
  "enabled": true,
  "name": "Submission guard",
  "description": "Run before submitting or pushing: validates hauntings, builds the engine, typechecks and runs every test.",
  "version": "1",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "runCommand",
    "command": "npm run check"
  }
}
