{
  "enabled": true,
  "name": "Accessibility check",
  "description": "Reviews edited UI components for accessibility problems.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": ["web/src/**/*.tsx", "crew-app/ui/src/**/*.tsx", "web/src/**/*.css", "crew-app/ui/src/**/*.css"]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Review the UI file that just changed for accessibility. Check: every form control has a label; interactive elements are real buttons or links and work with the keyboard; focus is visible; live updates (narration, status) use aria-live or role=status; color is not the only signal (pass/fail also has text or an icon); text contrast meets WCAG AA in both light and dark themes; animation respects prefers-reduced-motion. Fix clear problems directly and list anything that needs a decision."
  }
}
