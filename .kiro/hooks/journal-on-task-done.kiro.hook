{
  "enabled": true,
  "name": "Kiro journal",
  "description": "After the agent finishes a task, appends a short entry to docs/kiro-journal.md.",
  "version": "1",
  "when": {
    "type": "agentStop"
  },
  "then": {
    "type": "askAgent",
    "prompt": "If you just completed a task (code, spec, steering or hauntings changed), append one entry to docs/kiro-journal.md: the date, the task in one line, which Kiro feature helped (steering, spec, hook, property test, agent, MCP) and one thing that went wrong or surprised you, if any. Keep it under 6 lines and do not edit earlier entries. If nothing changed, do nothing."
  }
}
