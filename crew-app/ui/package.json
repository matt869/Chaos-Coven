{
  "name": "@witching-hour/daemonwatch-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Daemonwatch: schedule Witching Hour drills for a team and review their postmortems.",
  "scripts": {
    "dev": "vite --port 5174",
    "build": "tsc -p tsconfig.json --noEmit && vite build && vite build -c vite.crew.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "preview": "vite preview",
    "build:crew": "vite build -c vite.crew.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^29.1.1",
    "vite": "^8.3.8"
  }
}
